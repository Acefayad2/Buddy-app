{
  "expo": {
    "name": "Phone Buddy",
    "slug": "phone-buddy-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.phonebuddy.app",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "Phone Buddy uses Bluetooth to connect to devices and alert you if you leave one behind.",
        "NSBluetoothPeripheralUsageDescription": "Phone Buddy uses Bluetooth to connect to nearby devices.",
        "NSLocationWhenInUseUsageDescription": "Phone Buddy uses your location only when a device disconnects to record the last known location.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Phone Buddy uses location only when a device disconnects to record the last known location.",
        "UIBackgroundModes": [
          "bluetooth-central",
          "bluetooth-peripheral",
          "fetch",
          "remote-notification"
        ]
      },
      "associatedDomains": [
        "applinks:phonebuddy.app"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.phonebuddy.app",
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_ADVERTISE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.USE_FULL_SCREEN_INTENT"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "phonebuddy"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": [
            "./assets/notification-sound.wav"
          ]
        }
      ]
    ],
    "scheme": "phonebuddy",
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}
