# Supabase Configuration
# Copy this file to .env.local and fill in your actual values
# You can find these in your Supabase project dashboard: Project Settings → API

# Required: Your Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Required: Your Supabase anonymous/public key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required: Service role key (ONLY for server-side scripts, NEVER expose to client)
# This key bypasses Row Level Security - keep it secret!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Mobile App Configuration (optional, for React Native/Expo)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
